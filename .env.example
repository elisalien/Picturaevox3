# Configuration Picturaevox3
# Copiez ce fichier en .env et remplissez les valeurs

# Port du serveur
PORT=3000

# Environnement (development, production)
NODE_ENV=development

# URL Redis pour la persistance (optionnel)
# Si non défini, utilise seulement le stockage en mémoire
# Format: redis://[user]:[password]@[host]:[port]/[database]
# Exemples:
# - Local: redis://localhost:6379
# - Railway: redis://default:password@host:port
# - Upstash: redis://default:token@endpoint:port
REDIS_URL=redis://localhost:6379

# CORS - Origines autorisées (séparées par des virgules)
# En développement, toutes les origines sont autorisées
# En production, listez uniquement vos domaines
ALLOWED_ORIGINS=https://monapp.com,https://www.monapp.com

# Exemple pour plusieurs environnements:
# ALLOWED_ORIGINS=https://picturaevox.com,https://www.picturaevox.com,https://app.picturaevox.com

# ===== CONFIGURATION RAILWAY/RENDER (AUTO-DÉTECTÉE) =====
# Ces variables sont automatiquement détectées par le serveur
# Vous n'avez PAS besoin de les définir manuellement

# Railway auto-définit:
# RAILWAY_STATIC_URL=votre-app.up.railway.app

# Render auto-définit:
# RENDER_EXTERNAL_URL=https://votre-app.onrender.com

# Vous pouvez aussi définir manuellement:
# PUBLIC_URL=https://votre-domaine.com
# DOMAIN=https://votre-domaine.com

# ===== OSC (TouchDesigner / Ableton Live) =====
# OSC utilise UDP — fonctionne UNIQUEMENT en local (pas sur Railway/Render/Heroku)
# Sur les PaaS cloud, l'OSC est automatiquement désactivé

# Activer l'envoi OSC (false par défaut)
OSC_ENABLED=false

# TouchDesigner (port 7000 par défaut)
OSC_TD_ENABLED=true
OSC_TD_HOST=127.0.0.1
OSC_TD_PORT=7000

# Ableton Live (port 9000 par défaut, via OSCpilot/TouchOSC Bridge)
OSC_ABLETON_ENABLED=true
OSC_ABLETON_HOST=127.0.0.1
OSC_ABLETON_PORT=9000
